ANTHROPIC_API_KEY=sk-ant-...
# Meta (Facebook + Instagram) - get from developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_FACEBOOK_PAGE_ID=
# TikTok - get from developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
# Shopify - get from partners.shopify.com
SHOPIFY_STORE_DOMAIN=vintagebudthreads.myshopify.com
SHOPIFY_ACCESS_TOKEN=
# Database
# Local dev: sqlite+aiosqlite:///./budthreads.db
# Railway Postgres (auto-set when you add a Postgres plugin): postgresql://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./budthreads.db
# CORS — set to your Vercel frontend URL in production
FRONTEND_URL=http://localhost:3000
